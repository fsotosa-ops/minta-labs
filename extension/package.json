{
  "name": "minta-labs-entregables",
  "displayName": "minta-labs · Entregables",
  "description": "Convierte el análisis en informe académico o deck de negocio sin salir del editor.",
  "version": "0.1.0",
  "publisher": "sumadots",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Data Science", "Notebooks", "Other"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mintaLabs",
          "title": "Entregables",
          "icon": "media/icono.svg"
        }
      ]
    },
    "views": {
      "mintaLabs": [
        { "id": "mintaLabs.entregables", "name": "Proyecto" }
      ]
    },
    "commands": [
      { "command": "mintaLabs.cambiarAudiencia", "title": "minta-labs: Cambiar audiencia", "icon": "$(arrow-swap)" },
      { "command": "mintaLabs.construir", "title": "minta-labs: Construir el entregable", "icon": "$(play)" },
      { "command": "mintaLabs.abrirSlides", "title": "minta-labs: Abrir el deck en Google Slides", "icon": "$(browser)" },
      { "command": "mintaLabs.abrirTema", "title": "minta-labs: Configurar el tema" },
      { "command": "mintaLabs.refrescar", "title": "minta-labs: Refrescar", "icon": "$(refresh)" }
    ],
    "menus": {
      "view/title": [
        { "command": "mintaLabs.cambiarAudiencia", "when": "view == mintaLabs.entregables", "group": "navigation@1" },
        { "command": "mintaLabs.construir", "when": "view == mintaLabs.entregables", "group": "navigation@2" },
        { "command": "mintaLabs.refrescar", "when": "view == mintaLabs.entregables", "group": "navigation@3" }
      ]
    },
    "configuration": {
      "title": "minta-labs",
      "properties": {
        "mintaLabs.audiencia": {
          "type": "string",
          "enum": ["academia", "negocio"],
          "default": "negocio",
          "description": "Qué se construye: informe académico en PDF o deck de negocio."
        },
        "mintaLabs.slidesUrl": {
          "type": "string",
          "default": "",
          "description": "URL de la presentación de Google Slides que se embebe en el editor."
        },
        "mintaLabs.python": {
          "type": "string",
          "default": "uv run",
          "description": "Cómo invocar Python. Por defecto usa uv del proyecto."
        }
      }
    }
  }
}
